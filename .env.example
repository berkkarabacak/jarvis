# Shared secret for /api/* and /oauth/import (required in production)
API_SECRET=change-me-to-a-long-random-string

# Fernet key for encrypting OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Set true in production to refuse startup when API_SECRET/TOKEN_ENCRYPTION_KEY
# are unset or well-known defaults. Leave false for local dev/tests.
ENFORCE_SECURE_SECRETS=false

# SQLite path (default provider)
DATABASE_PATH=./data/agent_orchestrator.db
# sqlite | postgres | tencentdb (mysql legacy)
DATABASE_PROVIDER=sqlite
# true = do not silently fall back to SQLite if postgres/mysql config is incomplete
DATABASE_STRICT=false

# PostgreSQL / TencentDB PostgreSQL (ORCH-69 / D-007) — used when DATABASE_PROVIDER=postgres
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_SSL_MODE=require
POSTGRES_PGVECTOR_REQUIRED=false
# Apply app/migrations on process start (platform Postgres only)
POSTGRES_MIGRATE_ON_STARTUP=false

# Legacy TencentDB MySQL (frozen; do not extend for Control Room)
TENCENTDB_HOST=
TENCENTDB_PORT=3306
TENCENTDB_USER=
TENCENTDB_PASSWORD=
TENCENTDB_DATABASE=
TENCENTDB_SSL_MODE=PREFERRED

# --- LLM ---
# openrouter (default) | xai
LLM_PROVIDER=openrouter
# auto (OpenRouter Auto Beta) | fixed
LLM_MODEL_MODE=auto
OPENROUTER_API_KEY=
# Optional. Voice / Realtime and some computer vision use this when set.
OPENAI_API_KEY=
# Optional Kimi Code worker (api.kimi.com/coding). Alias: KIMI_API_KEY.
KIMI_CODE_API_KEY=
# Used when LLM_MODEL_MODE=fixed (or job override). Examples:
#   openrouter/auto
#   anthropic/claude-sonnet-4
#   openai/gpt-4.1-mini
#   x-ai/grok-4
DEFAULT_MODEL=openrouter/auto
LLM_TIMEOUT_SECONDS=600

# Executive runtime adapter: rpc | openrouter | null.
# Unset = auto: prime-rpc when PRIME_AGENT_ENABLED is set, else the in-process
# OpenRouter adapter when OPENROUTER_API_KEY is set, else null (no live chat).
# The in-process adapter needs no external binary, so a host with just the key
# above serves live public CEO chat out of the box.
# EXECUTIVE_PRIME_ADAPTER=

# Pinned external prime-agent binary (optional; needs the binary installed)
PRIME_AGENT_ENABLED=false
# PRIME_AGENT_BIN=prime-agent
# PRIME_AGENT_WORKDIR=

# Legacy xAI path (only when LLM_PROVIDER=xai)
TOKEN_PROVIDER=oauth
XAI_API_KEY=

# Server
HOST=0.0.0.0
PORT=8787
TZ=UTC

# Memory
MEMORY_MAX_CHARS=48000
MEMORY_VERSIONS_KEEP=20

PUBLIC_BASE_URL=https://berkkarabacak.com/agent-orchestrator

# Local PKCE login loopback (xAI only; must match borrowed client)
OAUTH_REDIRECT_HOST=127.0.0.1
OAUTH_REDIRECT_PORT=56121

# --- Herdr terminal agent runtime (optional job runner) ---
# Docs: https://herdr.dev/docs/  (Windows support is beta — set full path if needed)
HERDR_ENABLED=false
HERDR_BIN=herdr
# Windows example: HERDR_BIN=C:\Users\you\AppData\Local\herdr\herdr.exe
HERDR_SESSION=
HERDR_TIMEOUT_MS=120000
HERDR_DEFAULT_KIND=opencode

