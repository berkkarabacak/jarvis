<?xml version="1.0" encoding="utf-8"?>
<!-- Debug/internal sideload may point at a LAN Jarvis (http://192.168.x.x:8787). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
