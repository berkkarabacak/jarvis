# ==GRoK== Local Windows AI Control Room
# Copied to repo-root .env by scripts/windows/start-control-room.ps1 on first run.
# NEVER commit the real .env.

# Required for admin API and guest-session HMAC (auto-generated on first start if left as change-me)
API_SECRET=change-me-to-a-long-random-string

# Fernet key (auto-generated on first start if empty)
TOKEN_ENCRYPTION_KEY=

# --- LLM ---
LLM_PROVIDER=openrouter
LLM_MODEL_MODE=auto
DEFAULT_MODEL=openrouter/auto
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=600

# Jarvis local colleague (computer tools + memory). Keep false on public cloud hosts.
JARVIS_ENABLED=true
EXECUTIVE_PRIME_ADAPTER=jarvis
JARVIS_MODEL=openai/gpt-4.1-mini
# JARVIS_WORKSPACE=C:\Users\YOU\Documents\Jarvis
# JARVIS_VISION_MODEL=openai/gpt-4o-mini

# Executive adapter: jarvis | openrouter | rpc | null
# EXECUTIVE_PRIME_ADAPTER=jarvis

# --- Optional: Prime Agent for local file editing ---
# Install Prime (see docs/local-windows-app.md). Only enable when you want
# the executive to run tools against a folder on THIS PC.
PRIME_AGENT_ENABLED=false
# PRIME_AGENT_BIN=C:\Users\YOU\AppData\Local\prime-agent\prime-agent.exe
# Prefer a dedicated workspace, never your whole user profile or C:\
# PRIME_AGENT_WORKDIR=C:\Users\YOU\AI-Control-Room-Workspace

# SQLite (local default)
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/control_room.db
DATABASE_STRICT=false

# Loopback only — do not expose the local app to the LAN without a reverse proxy + auth
HOST=127.0.0.1
PORT=8787
TZ=UTC
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Keep off on a desktop machine unless you intentionally want Herdr jobs
HERDR_ENABLED=false

# Tencent / cloud memory adapters stay off locally
TENCENT_AGENT_MEMORY_ENABLED=false

# Agent bridge (OpenCode <-> Jarvis)
BRIDGE_ENABLED=true
BRIDGE_TOKEN=change-me-bridge-token
BRIDGE_MAX_TIER_AUTO=L1

# Permissions (ORCH-245/247)
JARVIS_PERMISSION_PROFILE=personal
# Optional extra allowlisted apps (CSV) for L3 auto-run without confirm
# JARVIS_APP_ALLOWLIST=spotify,slack
# JARVIS_APP_ALLOWLIST_FILE=

