# AI Control Room — aicontrolroom.nl environment template
#
# Copy to /opt/ai-control-room/.env on the host, fill in the two secrets, then:
#   chmod 600 /opt/ai-control-room/.env
#   chown berkkarabacak:berkkarabacak /opt/ai-control-room/.env
#
# This file is a TEMPLATE and is safe to commit. The real .env is NOT — it is
# gitignored and must never be committed, pasted into chat, or shipped to the
# browser. The frontend never receives any value from this file.

# --- LLM: free public chat runs on OpenRouter ---------------------------------
LLM_PROVIDER=openrouter
LLM_MODEL_MODE=auto
DEFAULT_MODEL=openrouter/auto
LLM_TIMEOUT_SECONDS=600

# REQUIRED. Paste the live OpenRouter key here on the host only.
# With this set and no PRIME_AGENT_ENABLED, the app auto-selects the in-process
# OpenRouter executive adapter and public chat works with no other setup.
OPENROUTER_API_KEY=

# Executive adapter selection: rpc | openrouter | null. Leave unset for auto
# (prime-rpc if PRIME_AGENT_ENABLED, else openrouter if a key is set, else null).
# EXECUTIVE_PRIME_ADAPTER=

# --- Admin API secret ---------------------------------------------------------
# MUST be at least 32 bytes and must not be a placeholder like "public",
# "change-me" or "dev-secret-change-me". The public executive gateway refuses
# to start below that threshold and EVERY public chat request then returns 503
# — the landing page still loads, so the failure looks like a provider outage.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# It gates the ADMIN API — /api/jobs (which can launch the Herdr runner and
# execute local commands), /api/settings/*, /api/memories, /oauth/import — and
# it is ALSO the HMAC key that pseudonymises guest IPs for the rate limiter and
# the fallback encryption key for OAuth tokens at rest. A guessable value hands
# over the admin API, makes stored visitor records reversible to real IPs, and
# lets an attacker forge quota subjects to bypass spend limits.
#
# It does NOT gate the public CEO chat — that surface is open by design.
API_SECRET=

# Fernet key for encrypting stored OAuth tokens at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Server / host ------------------------------------------------------------
HOST=127.0.0.1
PORT=8896
TZ=UTC
PUBLIC_BASE_URL=https://aicontrolroom.nl

# --- Database -----------------------------------------------------------------
# SQLite is the supported default for this ship. Postgres is the Control Room
# target once provisioned; flip DATABASE_PROVIDER and fill the POSTGRES_* block.
DATABASE_PROVIDER=sqlite
DATABASE_PATH=/opt/ai-control-room/data/control_room.db
DATABASE_STRICT=false

# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=
# POSTGRES_SSL_MODE=require
# POSTGRES_MIGRATE_ON_STARTUP=false

# --- Optional integrations: none of these block public chat --------------------
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Herdr terminal-agent job runner. Leave FALSE on a public host: it executes
# local commands and the jobs API that drives it is admin-gated, not public.
HERDR_ENABLED=false
