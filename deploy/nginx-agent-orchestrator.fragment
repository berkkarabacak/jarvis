    # --- Agent Orchestrator (ACTIVE) ---
    location = /agent-orchestrator { return 301 $scheme://$host/agent-orchestrator/; }
    location ^~ /agent-orchestrator/ {
        proxy_pass http://127.0.0.1:8895/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 900s;
        client_max_body_size 5M;
    }

    # Legacy Grok Automater path → Agent Orchestrator
    location = /grok-automater { return 301 $scheme://$host/agent-orchestrator/; }
    location ^~ /grok-automater/ {
        rewrite ^/grok-automater/(.*)$ /agent-orchestrator/$1 permanent;
    }
